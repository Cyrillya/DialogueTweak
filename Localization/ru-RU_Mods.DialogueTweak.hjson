Configs: {
	Configuration: {
		TextScrollingMode: {
			Label: Анимация появления текста по буквам
			Tooltip: Определяет скорость анимации плавного появления текста в диалоговой панели
		}

		DisplayName: Конфигурация

		DisplayPreference: {
			Label: Показывать предпочтения НИПов в условиях проживания
			Tooltip: Добавляет маленькие иконки биомов и голов других НИПов над диалоговой панелью, отображающие отношение этого НИПа к ним
		}

		DisplayHappiness: {
			Label: Отображать уровень счастья НИПов
			Tooltip: Показывает уровень счастья НИПа в процентах (на основе множителя цены). Взято из нововведения Terraria 1.4.5
		}

		VanillaUI: {
			Label: Использовать ванильную диалоговую панель
			Tooltip:
				'''
				Отключает диалоговую панель из мода и заменяет её на ванильную
				Включите эту настройку, если панель из мода плохо работает с НИПами из других модов или вызывает баги
				'''
		}

		PortraitDrawStyle: {
			Label: Стиль портретов в диалогах
			Tooltip: Устанавливает способ отображения НИПа на его портрете в диалоговой панели
		}

		PortraitFbStyle: {
			Label: Стиль при отсутствии портрета
			Tooltip:
				'''
				Устанавливает способ отображения портрета в диалоговой панели для НИПов, у которых нет своего портрета из 1.4.5
				Применяется только если настройка «Стиль портретов в диалогах» установлена на «Портрет»
				'''
		}
		
		PortraitAnimation: {
			Label: Анимация портрета
			Tooltip: Добавляет анимацию подпрыгивания портрета НИПа во время открытия диалогового окна
		}

		ShowSwapButton: {
			Label: Кнопка для переключения между диалоговыми панелями
			Tooltip:
				'''
				Добавляет кнопку переключения между ванильной и модовой диалоговыми панелями справа сверху от диалогового окна
				Используйте для удобного сравнения новой диалоговой панели с ванильной
				'''
		}
	}
	
	TextScrollingSpeed: {
		Tooltip: ""
		Slow.Label: Медленная
		Slow.Tooltip: ""
		Regular.Label: По умолчанию
		Regular.Tooltip: ""
		Fast.Label: Быстрая
		Fast.Tooltip: ""
		Disabled.Label: Отключена
		Disabled.Tooltip: ""
	}

	PortraitStyle: {
		Tooltip: ""
		LiveReaction.Label: В прямом эфире
		LiveReaction.Tooltip: ""
		Portrait.Label: Портрет
		Portrait.Tooltip: Стиль Terraria 1.4.5 
		Retro.Label: Целиком
		Retro.Tooltip: ""
		Profile.Label: Профиль
		Profile.Tooltip: ""
	}

	PortraitFallbackStyle: {
		Tooltip: ""
