Configs: {
	Configuration: {
		TextScrollingMode: {
			Label: 文本滚动
			Tooltip: 修改NPC对话文本一个一个字地出现的速度，可以禁用
		}

		DisplayName: 配置选项

		DisplayPreference: {
			Label: 显示NPC生活偏好
			Tooltip: 显示NPC对环境和其他NPC的喜好，这是此Mod添加的辅助功能
		}

		DisplayHappiness: {
			Label: 显示NPC幸福度百分比
			Tooltip: 显示NPC幸福度百分比（价格修正）。这是原版v1.4.5中的一个功能
		}

		VanillaUI: {
			Label: 使用原版对话面板
			Tooltip:
				'''
				允许你在游戏内开启原版对话面板
				若该模组的UI不兼容其他模组或出现BUG，可以尝试开启此选项
				'''
		}

		PortraitAnimation: {
			Label: 肖像动画
			Tooltip: NPC在说话时肖像是否有弹跳动画
		}

		ShowSwapButton: {
			Label: 对话面板切换按钮
			Tooltip:
				'''
				在对话面板右上角显示一个按钮
				用于在原版和Mod对话面板之间快捷切换
				'''
		}
	}

	TextScrollingSpeed: {
		Tooltip: ""
		Slow.Label: 缓慢
		Slow.Tooltip: ""
		Regular.Label: 默认
		Regular.Tooltip: ""
		Fast.Label: 快速
		Fast.Tooltip: ""
		Disabled.Label: 禁用
		Disabled.Tooltip: ""
	}
}

UISwitch: {
	ToVanilla: 切换到原版对话面板
	ToModded: 切换到Mod对话面板
}

Hate: 讨厌
Dislike: 不喜
Like: 喜欢
Love: 喜爱
