Configs: {
	Configuration: {
		TextScrollingMode: {
			Label: Text Scrolling
			Tooltip: Determines how fast NPC dialogue text will appear letter by letter. This can be disabled
		}

		DisplayName: Configuration

		DisplayPreference: {
			Label: Display NPC Living Preferences
			Tooltip: Shows NPC's preferences for biomes and other NPCs. This is a qol feature added by this mod
		}

		DisplayHappiness: {
			Label: Display NPC Happiness Percentage
			Tooltip: Shows NPC's happiness percentage (price modifier). This is a qol feature from Terraria v1.4.5
		}

		VanillaUI: {
			Label: Use Vanilla Chat GUI
			Tooltip:
				'''
				Allows you to open the vanilla dialogue panel in the game
				If the UI of this mod is not compatible with other mods or there are bugs, try enable this option
				'''
		}

		PortraitAnimation: {
			Label: Portrait Animation
			Tooltip: Determines whether NPC portraits will have the bouncing animation when they are talking
		}

		ShowSwapButton: {
			Label: Toggle GUI Style Button
			Tooltip:
				'''
				A shortcut displayed in the upper right corner of the dialogue panel
				to switch between vanilla and modded dialogue panels
				'''
		}
	}

	TextScrollingSpeed: {
		Tooltip: ""
		Slow.Label: Slow
		Slow.Tooltip: ""
		Regular.Label: Default
		Regular.Tooltip: ""
		Fast.Label: Fast
		Fast.Tooltip: ""
		Disabled.Label: Disabled
		Disabled.Tooltip: ""
	}
}

UISwitch: {
	ToVanilla: Switch to vanilla panel
	ToModded: Switch to modded panel
}

Hate: Hate
Dislike: Dislike
Like: Like
Love: Love
